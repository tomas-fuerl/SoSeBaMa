{
  "name": "sobama",
  "version": "0.0.0",
  "private": true,
  "description": "Song-Setlist-Band-Manager monorepo",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "24.18.1",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm docs:links",
    "docs:links": "node tools/check-markdown-links.mjs",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@sobama/eslint-config": "workspace:*",
    "@sobama/typescript-config": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
