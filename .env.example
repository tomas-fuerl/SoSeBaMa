# Wertfreie Dokumentationsvorlage. Keine Secrets oder Infrastrukturwerte
# eintragen. Reale Environment-Dateien werden nicht versioniert. Die Vorlage
# wird nicht automatisch geladen.

# Erlaubte Werte: DEV, TST oder PRD. Lokale Starts verwenden ausschließlich DEV.
SOSEBAMA_ENVIRONMENT=DEV
SOSEBAMA_API_HOST=localhost
SOSEBAMA_API_PORT=<LOCAL_API_PORT>

# Secrets werden ausschließlich auf der Synology gepflegt und je Umgebung
# getrennt bereitgestellt. Hier niemals Namen oder Werte produktiver Secrets
# ergänzen.
SOSEBAMA_SECRET_SOURCE=synology

# Die Datenbank ist ausschließlich aus dem App-Backend erreichbar. Dieser
# Teilschnitt enthält noch keine Datenbankverbindung.
SOSEBAMA_DATABASE_ACCESS=backend-only
