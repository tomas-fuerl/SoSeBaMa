# Wertfreie Dokumentationsvorlage. Keine Secrets oder Infrastrukturwerte
# eintragen. Reale Environment-Dateien werden nicht versioniert.

# Erlaubte Werte: DEV, TST oder PRD.
SOSBAMA_ENVIRONMENT=DEV

# Secrets werden ausschließlich auf der Synology gepflegt und je Umgebung
# getrennt bereitgestellt. Hier niemals Namen oder Werte produktiver Secrets
# ergänzen.
SOSBAMA_SECRET_SOURCE=synology

# Die Datenbank ist ausschließlich aus dem App-Backend erreichbar.
SOSBAMA_DATABASE_ACCESS=backend-only
